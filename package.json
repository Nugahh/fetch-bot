{
  "name": "fetch-bot",
  "version": "1.0.0",
  "description": "Hexagonal bot that watches housing offers on a site (al-in.fr) and emails only the new ones.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "preview": "tsx src/tools/preview-offers.ts",
    "typecheck": "tsc --noEmit",
    "build:lambda": "node scripts/build-lambda.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.632.0",
    "dotenv": "^16.4.5",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
