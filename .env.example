# ── Identifiants al-in.fr (obligatoire) ─────────────────────────────────
ALIN_LOGIN=
ALIN_PASSWORD=

# ── Envoi des mails via Gmail (obligatoire) ─────────────────────────────
# Adresse Gmail qui envoie les mails
SMTP_USER=
# Mot de passe d'APPLICATION Gmail (16 caractères, sans espaces)
SMTP_PASS=
# Destinataire des alertes
MAIL_TO=
# Optionnel, ex. "AL'in Bot <toi@gmail.com>" (défaut : SMTP_USER)
MAIL_FROM=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ── Filtres de recherche (optionnel — vide = pas de filtre) ─────────────
# Codes postaux, ex. 94420,94000
ALIN_POSTAL_CODES=
# Départements, ex. 94
ALIN_DEPARTMENTS=
# Loyer min / max, charges comprises
ALIN_MIN_RENT=
ALIN_MAX_RENT=
# APT (appartement) ou MIN (maison)
ALIN_KIND=

# ── Déploiement AWS (utilisé par `npm run deploy`) ──────────────────────
# Nom de la stack CloudFormation existante
# STACK_NAME=
# AWS_REGION=eu-west-3
# SCHEDULE=rate(15 minutes)
# Adresse qui reçoit l'alerte quand la Lambda plante (défaut : MAIL_TO)
# ALERT_EMAIL=
